@import './card.wxss';

.header-box {
  position: sticky;
  top: 0;
  z-index: 2000;
}

.nav-container {
  padding: 20rpx;
  background-color: var(--color-white);
  color: var(--color-btn-info);
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
}

.header-tab {
  padding: 10rpx 0;
  background-color: var(--color-white);
}

.user-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 20rpx;
  background-color: var(--color-white);
  border-top: 1rpx solid var(--color-border);
  font-size: 26rpx;
}

.user-bar .user-name {
  color: var(--color-darkGray);
}

.user-bar .user-action {
  color: var(--color-btn-danger);
}

.empty-tip {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-second);
}

.tag-row {
  display: flex;
  gap: 10rpx;
  margin: 6rpx 0;
}