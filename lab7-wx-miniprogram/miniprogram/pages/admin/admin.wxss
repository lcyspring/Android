@import '../index/card.wxss';

.header-box {
  position: sticky;
  top: 0;
  z-index: 2000;
}

.header-tab {
  padding: 10rpx 0;
  background-color: var(--color-white);
}

.info-line {
  font-size: 26rpx;
  color: var(--color-text-second);
  margin-top: 6rpx;
}

.info-line.danger {
  color: var(--color-btn-danger);
}

.empty-tip {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-second);
}
