<view class="header-box">
	<van-picker columns="{{ floorList }}" bind:change="selectFloor" visible-item-count="3" />

	<view class="header-tab">
		<ye-tab tab-list="{{tabList}}" font-size="28rpx" lrPadding="40rpx" bind:select="selectStatus"></ye-tab>
	</view>
</view>

<block wx:for="{{applyData}}" wx:key="_id">
	<view class="card-item">
		<view class="item-content border-bottom">
			<view class="left-box">
				<image src="{{item.levelIcon}}" mode="aspectFill"></image>
			</view>
			<view class="right-box">
				<text class="floor">{{item.floor}}栋{{item.dorm}} · {{item.name}}</text>
				<text class="desc">{{item.desc}}</text>
				<van-tag color="{{item.statusColor}}">{{item.status}}</van-tag>
				<text class="date">{{item.createTime}}</text>
				<view class="info-line" wx:if="{{item.workerName}}">维修人员：{{item.workerName}} {{item.workerPhone}}</view>
				<view class="info-line danger" wx:if="{{item.rejectReason}}">不受理原因：{{item.rejectReason}}</view>
			</view>
		</view>
		<view class="item-footer">
			<text data-id="{{item._id}}" bindtap="navDetail">查看详情</text>
			<text class="confirm-text-btn" data-id="{{item._id}}" data-index="{{index}}" wx:if="{{item.status === '未处理'}}"
				bindtap="confirmApply">审核通过</text>
			<text class="delete-text-btn" data-id="{{item._id}}" data-index="{{index}}" wx:if="{{item.status === '未处理'}}"
				bindtap="rejectApply">不受理</text>
			<text class="delete-text-btn" data-id="{{item._id}}" wx:if="{{item.status === '已处理' || item.status === '不受理'}}"
				bindtap="deleteApplyData">删除</text>
		</view>
		<view class="level-tag" style="background-color: {{ item.level === '普通维修' ? '#07c160' : '#ee0a24'}}">
			{{item.level}}</view>
	</view>
</block>

<view class="empty-tip" wx:if="{{applyData.length === 0}}">
	<text>暂无报修记录</text>
</view>
