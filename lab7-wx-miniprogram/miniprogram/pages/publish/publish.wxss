.notice-container {
  margin-bottom: 20rpx;
}

input, textarea {
  background-color: #f6f6f6;
  padding: 10rpx;
  color: var(--color-text-second);
}

.apply-item {
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  background-color: var(--color-white);
}

.in-1,
.in-4 {
  width: 250rpx;
  border-radius: 10rpx;
  text-align: center;
}

.text-dorm {
  margin: 0 20rpx;
}

.in-2,
.in-3 {
  width: 120rpx;
  border-radius: 10rpx;
  text-align: center;
}

.apply-desc {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  background-color: var(--color-white);
}

.apply-desc>text {
  margin-bottom: 20rpx;
}

.in-5 {
  border-radius: 10rpx;
  height: 150rpx;
  width: 100%;
}

/* 图片上传 */
.apply-images {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.apply-images>text {
  margin-bottom: 20rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 0 0 0 10rpx;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  background: #f6f6f6;
  border: 2rpx dashed #ccc;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #ccc;
}

.apply-btn {
  width: 80%;
  margin: 100rpx auto 0 auto;
}
