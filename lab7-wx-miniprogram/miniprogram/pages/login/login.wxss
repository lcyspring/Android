.login-page {
	padding: 60rpx 40rpx;
	min-height: 100vh;
	background-color: var(--color-white);
}

.login-header {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-bottom: 60rpx;
}

.login-header .title {
	font-size: 48rpx;
	font-weight: bold;
	color: var(--color-btn-info);
}

.login-header .subtitle {
	margin-top: 12rpx;
	font-size: 28rpx;
	color: var(--color-text-second);
}

.form-box {
	margin-bottom: 50rpx;
}

.form-item {
	display: flex;
	align-items: center;
	height: 100rpx;
	border-top: 1rpx solid var(--color-border);
	position: relative;
}

.form-item .label {
	width: 120rpx;
	font-size: 30rpx;
	color: var(--color-black);
}

.form-item .input {
	flex: 1;
	font-size: 30rpx;
}

.input-placeholder {
	color: var(--color-gray);
}

.btn-box {
	margin-top: 20rpx;
}

.wechat-box {
	display: flex;
	justify-content: center;
	margin-top: 30rpx;
}

.wechat-link {
	font-size: 28rpx;
	color: var(--color-btn-info);
}

.tips {
	margin-top: 70rpx;
	display: flex;
	flex-direction: column;
	gap: 12rpx;
}

.tips-title {
	font-size: 26rpx;
	color: var(--color-text-second);
	margin-bottom: 6rpx;
}

.tips-item {
	font-size: 26rpx;
	color: var(--color-grey);
}
