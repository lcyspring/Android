/* pages/index/index.wxss */

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.toolbar__title {
  font-size: 26rpx;
  color: #6B6875;
}

.toolbar__btn {
  font-size: 24rpx !important;
  padding: 0 24rpx !important;
  line-height: 56rpx !important;
}

/* ---- 四态占位 ---- */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
}

.state__spinner {
  width: 72rpx;
  height: 72rpx;
  border: 8rpx solid #D9D2EC;
  border-top-color: #6750A4;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 28rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state__icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.state__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1C1B1F;
  margin-bottom: 12rpx;
}

.state__hint {
  font-size: 26rpx;
  color: #7A7686;
  text-align: center;
}

.state__hint--break {
  word-break: break-all;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.state__retry {
  margin-top: 32rpx;
  width: 280rpx;
}

/* ---- 任务卡片 ---- */
.todo {
  transition: transform 0.1s ease;
}

.todo--hover {
  transform: scale(0.98);
  background: #F7F4FD;
}

.todo__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.todo__id {
  font-size: 24rpx;
  color: #9A95AA;
}

.todo__badge {
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 24rpx;
}

.todo__badge--doing {
  color: #B3261E;
  background: #F9DEDC;
}

.todo__badge--done {
  color: #386A20;
  background: #E2F4D8;
}

.todo__title {
  font-size: 30rpx;
  line-height: 1.5;
  color: #1C1B1F;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.todo__foot {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.todo__go {
  font-size: 24rpx;
  color: #6750A4;
}
