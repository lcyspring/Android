/* pages/detail/detail.wxss */

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 48rpx;
}

.state__spinner {
  width: 72rpx;
  height: 72rpx;
  border: 8rpx solid #D9D2EC;
  border-top-color: #6750A4;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  margin-bottom: 28rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state__icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.state__title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.state__hint {
  font-size: 26rpx;
  color: #7A7686;
  text-align: center;
}

.state__hint--break {
  word-break: break-all;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.state__retry {
  margin-top: 32rpx;
  width: 280rpx;
}

.detail {
  margin-top: 24rpx;
}

.detail__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #EEEAF5;
  margin-bottom: 24rpx;
}

.detail__id {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C1B1F;
}

.detail__badge {
  font-size: 24rpx;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
}

.detail__badge--doing {
  color: #B3261E;
  background: #F9DEDC;
}

.detail__badge--done {
  color: #386A20;
  background: #E2F4D8;
}

.detail__row {
  margin-bottom: 28rpx;
}

.detail__label {
  display: block;
  font-size: 24rpx;
  color: #9A95AA;
  margin-bottom: 10rpx;
}

.detail__value {
  font-size: 30rpx;
  line-height: 1.6;
  color: #1C1B1F;
  word-break: break-all;
}

.detail__back {
  margin-top: 48rpx;
}
