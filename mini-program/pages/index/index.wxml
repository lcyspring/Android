<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 加载态 -->
  <view wx:if="{{isLoading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 错误态 -->
  <view wx:elif="{{error}}" class="error-box">
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 列表态 -->
  <block wx:else>
    <view class="list-header">
      <text class="header-title">待办事项 ({{todos.length}})</text>
    </view>
    <view
      wx:for="{{todos}}"
      wx:key="id"
      class="todo-item"
      data-id="{{item.id}}"
      bindtap="onItemTap"
    >
      <!-- 点击圆圈切换完成状态，catchtap 阻止冒泡避免触发跳转 -->
      <view
        class="check {{item.completed ? 'checked' : ''}}"
        data-id="{{item.id}}"
        catchtap="onToggleComplete"
      >
        <text wx:if="{{item.completed}}">✓</text>
      </view>
      <view class="todo-content">
        <text class="todo-title {{item.completed ? 'done' : ''}}">{{item.title}}</text>
        <text class="todo-id">#{{item.id}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </block>
</view>
