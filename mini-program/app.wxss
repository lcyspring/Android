/* app.wxss - 全局样式 */
page {
  background-color: #f3f4f6;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: #1f2937;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
  font-size: 32rpx;
  color: #6b7280;
}

.error-box {
  background-color: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  text-align: center;
}

.error-text {
  color: #dc2626;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.retry-btn {
  background-color: #dc2626;
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 12rpx;
  display: inline-block;
}
